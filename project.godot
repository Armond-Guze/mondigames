config_version=5

[application]
config/name="MondiGames - Prototype"
run/main_scene="res://arena.tscn"

[display]
window/size/viewport_width=1100
window/size/viewport_height=680
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.075, 0.1, 0.14, 1)
